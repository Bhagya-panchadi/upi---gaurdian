# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_N8N_WEBHOOK_URL: Optional default Production Webhook URL for n8n scam detection workflow.
# Users can also configure this directly in the UPI Guardian UI settings.
VITE_N8N_WEBHOOK_URL="https://your-n8n-instance.com/webhook/your-production-path"

# VITE_N8N_CHATBOT_WEBHOOK_URL: Optional separate default Webhook URL for n8n AI Chatbot workflow.
# Users can configure this directly in the UPI Guardian Assistant chat settings.
VITE_N8N_CHATBOT_WEBHOOK_URL="https://your-n8n-instance.com/webhook/your-chatbot-path"
